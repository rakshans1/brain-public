#!/bin/bash

set -e

run_deps() {
  npm i
}

run_serve() {
  npx quartz create
}

run_server() {
  npx quartz build --serve
}

fn_exists() { declare -F "$1" >/dev/null; }

run() {
  local cmd=$1
  shift
  local fn="run_$cmd"

  if fn_exists $fn; then
    $fn ${@}
  else
    with_dev_env
    eval $cmd "${@}"
  fi
}

run ${@}
